rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. GLOBAL SAFETY NET (DEFAULT DENY)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. CORE AUTHENTICATION & TENANT ISOLATION PRIMITIVES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-.:@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return userDocExists() ? getUserData().role : '';
    }

    function userTenantId() {
      return userDocExists() ? getUserData().tenantId : '';
    }

    function isMasterEmail() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email == 'financeirorenanuk@gmail.com' ||
         request.auth.token.email == 'admin@kitchenflow.com');
    }

    function isSaasAdmin() {
      return isSignedIn() && (isMasterEmail() || userRole() == 'SAAS_ADMIN');
    }

    function belongsToTenant(tenantId) {
      return isSignedIn() &&
        tenantId is string &&
        tenantId.size() > 0 &&
        (isSaasAdmin() || (userDocExists() && userTenantId() == tenantId));
    }

    function isTenantAdminOrManager(tenantId) {
      return belongsToTenant(tenantId) &&
        (isSaasAdmin() || userRole() in ['OWNER', 'ADMIN', 'MANAGER']);
    }

    function isTenantFinanceAuthorized(tenantId) {
      return belongsToTenant(tenantId) &&
        (isSaasAdmin() || userRole() in ['OWNER', 'ADMIN', 'MANAGER', 'CASHIER']);
    }

    function isTenantOrderAuthorized(tenantId) {
      return belongsToTenant(tenantId) &&
        (isSaasAdmin() || userRole() in ['OWNER', 'ADMIN', 'MANAGER', 'CASHIER', 'WAITER', 'CHEF', 'KDS']);
    }

    function isTenantInventoryAuthorized(tenantId) {
      return belongsToTenant(tenantId) &&
        (isSaasAdmin() || userRole() in ['OWNER', 'ADMIN', 'MANAGER', 'CHEF', 'STOCK_ANALYST', 'CASHIER']);
    }

    function hasNoPlaintextPassword(data) {
      return !('password' in data);
    }

    function isTenantImmutable() {
      return !('tenantId' in existing()) || incoming().tenantId == existing().tenantId;
    }

    // =========================================================================
    // 2. USERS COLLECTION (/users/{userId})
    // =========================================================================
    function isValidUserPayload(data) {
      return hasNoPlaintextPassword(data) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 254)) &&
        (!('name' in data) || (data.name is string && data.name.size() <= 200)) &&
        (!('role' in data) || (data.role is string && data.role in [
          'OWNER', 'ADMIN', 'MANAGER', 'CASHIER', 'WAITER', 'CHEF', 'KDS', 'COURIER', 'CUSTOMER', 'STOCK_ANALYST', 'SAAS_ADMIN'
        ])) &&
        (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128));
    }

    match /users/{userId} {
      // Leitura: próprio usuário, gestor do mesmo tenant ou SAAS_ADMIN
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId ||
        isSaasAdmin() ||
        (resource != null && belongsToTenant(existing().tenantId))
      );

      // Listagem: isolada por tenantId ou próprio email do usuário autenticado
      allow list: if isSignedIn() && (
        isSaasAdmin() ||
        existing().id == request.auth.uid ||
        (request.auth.token.email != null && existing().email == request.auth.token.email) ||
        belongsToTenant(existing().tenantId)
      );

      // Criação: sem senha em texto puro; auto-cadastro apenas para si mesmo (sem escalar para SAAS_ADMIN), ou por admin do tenant
      allow create: if isSignedIn() && isValidId(userId) && isValidUserPayload(incoming()) && (
        isSaasAdmin() ||
        (request.auth.uid == userId && incoming().role != 'SAAS_ADMIN') ||
        (isTenantAdminOrManager(incoming().tenantId) && incoming().role != 'SAAS_ADMIN' && incoming().role != 'CUSTOMER')
      );

      // Atualização: nunca permite gravar campo password; usuário comum não pode alterar o próprio role ou tenantId
      allow update: if isSignedIn() && isValidId(userId) && isValidUserPayload(incoming()) && (
        isSaasAdmin() ||
        (request.auth.uid == userId &&
          incoming().role == existing().role &&
          incoming().tenantId == existing().tenantId) ||
        (isTenantAdminOrManager(existing().tenantId) &&
          incoming().tenantId == existing().tenantId &&
          incoming().role != 'SAAS_ADMIN')
      );

      allow delete: if isSignedIn() && isValidId(userId) && (
        isSaasAdmin() ||
        isTenantAdminOrManager(existing().tenantId)
      );
    }

    // =========================================================================
    // 3. TENANTS COLLECTION (/tenants/{tenantId})
    // =========================================================================
    match /tenants/{tenantId} {
      // Leitura de perfil básico de vitrine (nome, logo, categoria) para listagem no Marketplace
      allow get: if isValidId(tenantId);
      allow list: if true;

      allow create: if isSignedIn() && isValidId(tenantId) && (
        isSaasAdmin() ||
        (incoming().ownerId == request.auth.uid)
      );

      allow update: if isSignedIn() && isValidId(tenantId) && (
        isSaasAdmin() ||
        isTenantAdminOrManager(tenantId) ||
        existing().ownerId == request.auth.uid
      );

      allow delete: if isSaasAdmin();
    }

    // =========================================================================
    // 4. SETTINGS COLLECTION (/settings/{settingId})
    // =========================================================================
    match /settings/{settingId} {
      // Documentos globais de configuração de vitrine ('marketplace', 'saas_config') podem ser lidos na vitrine.
      // Configurações internas de restaurante exigem pertencer ao tenant autenticado.
      allow get: if isValidId(settingId) && (
        settingId in ['marketplace', 'saas_config'] ||
        (isSignedIn() && belongsToTenant(settingId))
      );

      allow list: if isSignedIn() && (
        isSaasAdmin() ||
        belongsToTenant(resource.id)
      );

      allow create, update: if isSignedIn() && isValidId(settingId) && (
        isSaasAdmin() ||
        (settingId != 'marketplace' && settingId != 'saas_config' && isTenantOrderAuthorized(settingId))
      );

      allow delete: if isSaasAdmin();
    }

    // Vitrine pública sanitizada (apenas dados públicos de cardápio/horário, sem chaves fiscais ou caixa)
    match /publicStorefronts/{tenantId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(tenantId) && (
        isSaasAdmin() || isTenantOrderAuthorized(tenantId)
      );
      allow delete: if isSaasAdmin();
    }

    // =========================================================================
    // 5. PRODUCTS COLLECTION (/products/{productId})
    // =========================================================================
    function isValidProductPayload(data) {
      return data.tenantId is string && data.tenantId.size() >= 1 && data.tenantId.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.price is number && data.price >= 0 &&
        (!('stock' in data) || (data.stock is number && data.stock >= 0));
    }

    match /products/{productId} {
      // Produtos ativos do cardápio podem ser consultados na vitrine; produtos internos exigem autenticação do tenant
      allow get: if isValidId(productId) && (
        (existing().active != false && existing().isAvailableOnline != false) ||
        (isSignedIn() && belongsToTenant(existing().tenantId))
      );
      allow list: if (existing().active != false && existing().isAvailableOnline != false) ||
        (isSignedIn() && belongsToTenant(existing().tenantId));

      allow create: if isSignedIn() && isValidId(productId) &&
        isValidProductPayload(incoming()) &&
        isTenantInventoryAuthorized(incoming().tenantId);

      allow update: if isSignedIn() && isValidId(productId) &&
        isValidProductPayload(incoming()) &&
        isTenantImmutable() &&
        (isTenantInventoryAuthorized(existing().tenantId) || isTenantOrderAuthorized(existing().tenantId));

      allow delete: if isSignedIn() && isValidId(productId) &&
        isTenantAdminOrManager(existing().tenantId);
    }

    // =========================================================================
    // 6. ORDERS COLLECTION (/orders/{orderId})
    // =========================================================================
    function isValidOrderPayload(data) {
      return data.tenantId is string && data.tenantId.size() >= 1 && data.tenantId.size() <= 128 &&
        data.status is string && data.status in [
          'pending', 'pending_acceptance', 'accepted', 'preparing', 'ready', 'delivering', 'delivered', 'finished', 'cancelled'
        ] &&
        data.total is number && data.total >= 0;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (
        isTenantOrderAuthorized(existing().tenantId) ||
        (userRole() == 'COURIER' && existing().courierId == request.auth.uid) ||
        (userRole() == 'CUSTOMER' && existing().customerId == request.auth.uid)
      );

      allow list: if isSignedIn() && (
        isTenantOrderAuthorized(existing().tenantId) ||
        (userRole() == 'COURIER' && existing().courierId == request.auth.uid) ||
        (userRole() == 'CUSTOMER' && existing().customerId == request.auth.uid)
      );

      allow create: if isValidId(orderId) &&
        isValidOrderPayload(incoming()) && (
          (isSignedIn() && isTenantOrderAuthorized(incoming().tenantId)) ||
          (incoming().status == 'pending' && incoming().source in ['marketplace', 'digital_menu', 'qr_code', 'whatsapp'])
        );

      allow update: if isSignedIn() && isValidId(orderId) &&
        isValidOrderPayload(incoming()) &&
        isTenantImmutable() && (
          isTenantOrderAuthorized(existing().tenantId) ||
          (userRole() == 'COURIER' &&
            existing().courierId == request.auth.uid &&
            incoming().courierId == existing().courierId &&
            incoming().total == existing().total)
        );

      allow delete: if isSignedIn() && isValidId(orderId) &&
        isTenantAdminOrManager(existing().tenantId);
    }

    // =========================================================================
    // 7. DINING TABLES COLLECTION (/diningTables/{tableId} & /tables/{tableId})
    // =========================================================================
    match /diningTables/{tableId} {
      allow get: if isSignedIn() && isValidId(tableId) && isTenantOrderAuthorized(existing().tenantId);
      allow list: if isSignedIn() && isTenantOrderAuthorized(existing().tenantId);

      allow create: if isSignedIn() && isValidId(tableId) &&
        incoming().tenantId is string &&
        isTenantOrderAuthorized(incoming().tenantId);

      allow update: if isSignedIn() && isValidId(tableId) &&
        isTenantImmutable() &&
        isTenantOrderAuthorized(existing().tenantId);

      allow delete: if isSignedIn() && isValidId(tableId) &&
        isTenantAdminOrManager(existing().tenantId);
    }

    match /tables/{tableId} {
      allow get: if isSignedIn() && isValidId(tableId) && isTenantOrderAuthorized(existing().tenantId);
      allow list: if isSignedIn() && isTenantOrderAuthorized(existing().tenantId);
      allow create: if isSignedIn() && isValidId(tableId) && isTenantOrderAuthorized(incoming().tenantId);
      allow update: if isSignedIn() && isValidId(tableId) && isTenantImmutable() && isTenantOrderAuthorized(existing().tenantId);
      allow delete: if isSignedIn() && isValidId(tableId) && isTenantAdminOrManager(existing().tenantId);
    }

    // =========================================================================
    // 8. CUSTOMERS COLLECTION (/customers/{customerId}) - PII ISOLATION
    // =========================================================================
    match /customers/{customerId} {
      allow get: if isSignedIn() && isValidId(customerId) &&
        belongsToTenant(existing().tenantId) &&
        (isSaasAdmin() || userRole() in ['OWNER', 'ADMIN', 'MANAGER', 'CASHIER', 'WAITER']);

      allow list: if isSignedIn() &&
        belongsToTenant(existing().tenantId) &&
        (isSaasAdmin() || userRole() in ['OWNER', 'ADMIN', 'MANAGER', 'CASHIER', 'WAITER']);

      allow create: if isSignedIn() && isValidId(customerId) &&
        incoming().tenantId is string &&
        belongsToTenant(incoming().tenantId) &&
        (isSaasAdmin() || userRole() in ['OWNER', 'ADMIN', 'MANAGER', 'CASHIER', 'WAITER']);

      allow update: if isSignedIn() && isValidId(customerId) &&
        isTenantImmutable() &&
        belongsToTenant(existing().tenantId) &&
        (isSaasAdmin() || userRole() in ['OWNER', 'ADMIN', 'MANAGER', 'CASHIER']);

      allow delete: if isSignedIn() && isValidId(customerId) &&
        isTenantAdminOrManager(existing().tenantId);
    }

    // =========================================================================
    // 9. COURIERS COLLECTION (/couriers/{courierId})
    // =========================================================================
    match /couriers/{courierId} {
      allow get: if isSignedIn() && isValidId(courierId) && (
        request.auth.uid == courierId ||
        belongsToTenant(existing().tenantId)
      );

      allow list: if isSignedIn() && (
        isSaasAdmin() ||
        existing().id == request.auth.uid ||
        belongsToTenant(existing().tenantId)
      );

      allow create: if isSignedIn() && isValidId(courierId) &&
        hasNoPlaintextPassword(incoming()) && (
          request.auth.uid == courierId ||
          isTenantAdminOrManager(incoming().tenantId)
        );

      allow update: if isSignedIn() && isValidId(courierId) &&
        hasNoPlaintextPassword(incoming()) && (
          request.auth.uid == courierId ||
          (isTenantImmutable() && belongsToTenant(existing().tenantId) &&
            userRole() in ['OWNER', 'ADMIN', 'MANAGER', 'CASHIER'])
        );

      allow delete: if isSignedIn() && isValidId(courierId) &&
        isTenantAdminOrManager(existing().tenantId);
    }

    // =========================================================================
    // 10. FINANCIAL RECORDS & CASH CLOSINGS (STRICT RBAC)
    // =========================================================================
    function isValidFinancialRecord(data) {
      return data.tenantId is string && data.tenantId.size() >= 1 && data.tenantId.size() <= 128 &&
        data.type in ['income', 'expense'] &&
        data.amount is number && data.amount >= 0;
    }

    match /financialRecords/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && isTenantFinanceAuthorized(existing().tenantId);
      allow list: if isSignedIn() && isTenantFinanceAuthorized(existing().tenantId);

      allow create: if isSignedIn() && isValidId(recordId) &&
        isValidFinancialRecord(incoming()) && (
          isTenantFinanceAuthorized(incoming().tenantId) ||
          // Entregador autenticado do próprio tenant pode lançar apenas despesa de comissão/diária vinculada a si
          (belongsToTenant(incoming().tenantId) && userRole() == 'COURIER' && incoming().type == 'expense')
        );

      allow update: if isSignedIn() && isValidId(recordId) &&
        isValidFinancialRecord(incoming()) &&
        isTenantImmutable() &&
        isTenantFinanceAuthorized(existing().tenantId);

      allow delete: if isSignedIn() && isValidId(recordId) &&
        isTenantAdminOrManager(existing().tenantId);
    }

    match /financial_records/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && isTenantFinanceAuthorized(existing().tenantId);
      allow list: if isSignedIn() && isTenantFinanceAuthorized(existing().tenantId);
      allow create: if isSignedIn() && isValidId(recordId) && isValidFinancialRecord(incoming()) && isTenantFinanceAuthorized(incoming().tenantId);
      allow update: if isSignedIn() && isValidId(recordId) && isValidFinancialRecord(incoming()) && isTenantImmutable() && isTenantFinanceAuthorized(existing().tenantId);
      allow delete: if isSignedIn() && isValidId(recordId) && isTenantAdminOrManager(existing().tenantId);
    }

    match /cashClosings/{closingId} {
      allow get: if isSignedIn() && isValidId(closingId) && isTenantFinanceAuthorized(existing().tenantId);
      allow list: if isSignedIn() && isTenantFinanceAuthorized(existing().tenantId);

      allow create: if isSignedIn() && isValidId(closingId) &&
        incoming().tenantId is string &&
        isTenantFinanceAuthorized(incoming().tenantId);

      allow update: if isSignedIn() && isValidId(closingId) &&
        isTenantImmutable() &&
        isTenantAdminOrManager(existing().tenantId);

      allow delete: if isSignedIn() && isValidId(closingId) &&
        isTenantAdminOrManager(existing().tenantId);
    }

    match /cash_closings/{closingId} {
      allow get: if isSignedIn() && isValidId(closingId) && isTenantFinanceAuthorized(existing().tenantId);
      allow list: if isSignedIn() && isTenantFinanceAuthorized(existing().tenantId);
      allow create: if isSignedIn() && isValidId(closingId) && incoming().tenantId is string && isTenantFinanceAuthorized(incoming().tenantId);
      allow update: if isSignedIn() && isValidId(closingId) && isTenantImmutable() && isTenantAdminOrManager(existing().tenantId);
      allow delete: if isSignedIn() && isValidId(closingId) && isTenantAdminOrManager(existing().tenantId);
    }

    // =========================================================================
    // 11. RAW MATERIALS & BANK ACCOUNTS
    // =========================================================================
    match /rawMaterials/{materialId} {
      allow get: if isSignedIn() && isValidId(materialId) && isTenantInventoryAuthorized(existing().tenantId);
      allow list: if isSignedIn() && isTenantInventoryAuthorized(existing().tenantId);

      allow create: if isSignedIn() && isValidId(materialId) &&
        incoming().tenantId is string &&
        isTenantInventoryAuthorized(incoming().tenantId);

      allow update: if isSignedIn() && isValidId(materialId) &&
        isTenantImmutable() &&
        isTenantInventoryAuthorized(existing().tenantId);

      allow delete: if isSignedIn() && isValidId(materialId) &&
        isTenantAdminOrManager(existing().tenantId);
    }

    match /bankAccounts/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && isTenantFinanceAuthorized(existing().tenantId);
      allow list: if isSignedIn() && isTenantFinanceAuthorized(existing().tenantId);

      allow create: if isSignedIn() && isValidId(accountId) &&
        incoming().tenantId is string &&
        isTenantAdminOrManager(incoming().tenantId);

      allow update: if isSignedIn() && isValidId(accountId) &&
        isTenantImmutable() &&
        isTenantFinanceAuthorized(existing().tenantId);

      allow delete: if isSignedIn() && isValidId(accountId) &&
        isTenantAdminOrManager(existing().tenantId);
    }

    // =========================================================================
    // 12. FISCAL DOCUMENTS & CERTIFICATES
    // =========================================================================
    match /fiscal_documents/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && isTenantFinanceAuthorized(existing().tenantId);
      allow list: if isSignedIn() && isTenantFinanceAuthorized(existing().tenantId);

      allow create: if isSignedIn() && isValidId(docId) &&
        incoming().tenantId is string &&
        isTenantFinanceAuthorized(incoming().tenantId);

      allow update: if isSignedIn() && isValidId(docId) &&
        isTenantImmutable() &&
        isTenantFinanceAuthorized(existing().tenantId);

      allow delete: if false; // Documentos fiscais são imutáveis contra deleção
    }

    match /fiscalNotes/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && isTenantFinanceAuthorized(existing().tenantId);
      allow list: if isSignedIn() && isTenantFinanceAuthorized(existing().tenantId);
      allow create, update: if isSignedIn() && isValidId(docId) && isTenantFinanceAuthorized(incoming().tenantId);
      allow delete: if false;
    }

    match /certificates/{certId} {
      allow get: if isSignedIn() && isValidId(certId) && isTenantAdminOrManager(existing().tenantId);
      allow list: if isSignedIn() && isTenantAdminOrManager(existing().tenantId);
      allow create, update: if isSignedIn() && isValidId(certId) &&
        hasNoPlaintextPassword(incoming()) &&
        isTenantAdminOrManager(incoming().tenantId);
      allow delete: if isSignedIn() && isValidId(certId) && isTenantAdminOrManager(existing().tenantId);
    }

    // =========================================================================
    // 13. INTEGRATION EVENTS & AUDIT LOGS
    // =========================================================================
    match /integration_events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId) && belongsToTenant(existing().tenantId);
      allow list: if isSignedIn() && belongsToTenant(existing().tenantId);

      allow create: if isSignedIn() && isValidId(eventId) &&
        incoming().tenantId is string &&
        belongsToTenant(incoming().tenantId);

      allow update: if isSignedIn() && isValidId(eventId) &&
        isTenantImmutable() &&
        belongsToTenant(existing().tenantId);

      allow delete: if isSaasAdmin();
    }

    match /auditLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isTenantAdminOrManager(existing().tenantId);
      allow list: if isSignedIn() && isTenantAdminOrManager(existing().tenantId);

      allow create: if isSignedIn() && isValidId(logId) &&
        incoming().tenantId is string &&
        belongsToTenant(incoming().tenantId);

      allow update, delete: if false; // Logs de auditoria são imutáveis (append-only)
    }

    match /audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isTenantAdminOrManager(existing().tenantId);
      allow list: if isSignedIn() && isTenantAdminOrManager(existing().tenantId);
      allow create: if isSignedIn() && isValidId(logId) && incoming().tenantId is string && belongsToTenant(incoming().tenantId);
      allow update, delete: if false;
    }

    // =========================================================================
    // 14. SAAS PLATFORM & MARKETPLACE COLLECTIONS
    // =========================================================================
    match /plans/{planId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSaasAdmin();
    }

    match /commerceCategories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isSaasAdmin();
    }

    match /marketplace_settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSaasAdmin();
    }

    match /marketplaceInvoices/{invoiceId} {
      allow get: if isSignedIn() && isValidId(invoiceId) && isTenantFinanceAuthorized(existing().tenantId);
      allow list: if isSignedIn() && isTenantFinanceAuthorized(existing().tenantId);
      allow create: if isSignedIn() && isValidId(invoiceId) &&
        incoming().tenantId is string &&
        belongsToTenant(incoming().tenantId);
      allow update, delete: if isSaasAdmin();
    }

    match /saasLedger/{entryId} {
      allow get, list, create, update, delete: if isSaasAdmin();
    }

    match /saasPayments/{paymentId} {
      allow get, list: if isSignedIn() && (isSaasAdmin() || isTenantAdminOrManager(existing().tenantId));
      allow create, update, delete: if isSaasAdmin();
    }

    match /leads/{leadId} {
      allow get, list, create, update, delete: if isSaasAdmin();
    }

    match /tickets/{ticketId} {
      allow get, list: if isSignedIn() && (isSaasAdmin() || belongsToTenant(existing().tenantId));
      allow create: if isSignedIn() && belongsToTenant(incoming().tenantId);
      allow update: if isSignedIn() && isTenantImmutable() && (isSaasAdmin() || belongsToTenant(existing().tenantId));
      allow delete: if isSaasAdmin();
    }
  }
}
