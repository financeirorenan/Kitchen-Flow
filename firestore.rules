rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. CORE HELPERS & MULTI-TENANT ISOLATION PRIMITIVES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasTenantId() {
      return ('tenantId' in incoming()) &&
        incoming().tenantId is string &&
        incoming().tenantId.size() >= 1 &&
        incoming().tenantId.size() <= 128;
    }

    function isTenantImmutable() {
      return resource == null ||
        !('tenantId' in existing()) ||
        !('tenantId' in incoming()) ||
        incoming().tenantId == existing().tenantId;
    }

    // =========================================================================
    // 2. USERS & TENANTS (/users/{userId}, /tenants/{tenantId})
    // =========================================================================
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isValidId(userId);
      allow update: if isValidId(userId) && isTenantImmutable();
      allow delete: if isValidId(userId);
    }

    match /tenants/{tenantId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(tenantId);
    }

    // =========================================================================
    // 3. SETTINGS & PUBLIC STOREFRONTS (/settings/{settingId})
    // =========================================================================
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    match /publicStorefronts/{tenantId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(tenantId);
    }

    // =========================================================================
    // 4. TENANT-ISOLATED OPERATIONAL COLLECTIONS
    // =========================================================================
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) && hasTenantId();
      allow update: if isValidId(productId) && isTenantImmutable();
      allow delete: if isValidId(productId);
    }

    match /orders/{orderId} {
      allow get, list: if true;
      allow create: if isValidId(orderId) && hasTenantId();
      allow update: if isValidId(orderId) && isTenantImmutable();
      allow delete: if isValidId(orderId);
    }

    match /diningTables/{tableId} {
      allow get, list: if true;
      allow create: if isValidId(tableId) && hasTenantId();
      allow update: if isValidId(tableId) && isTenantImmutable();
      allow delete: if isValidId(tableId);
    }

    match /tables/{tableId} {
      allow get, list: if true;
      allow create: if isValidId(tableId) && hasTenantId();
      allow update: if isValidId(tableId) && isTenantImmutable();
      allow delete: if isValidId(tableId);
    }

    match /customers/{customerId} {
      allow get, list: if true;
      allow create: if isValidId(customerId) && hasTenantId();
      allow update: if isValidId(customerId) && isTenantImmutable();
      allow delete: if isValidId(customerId);
    }

    match /couriers/{courierId} {
      allow get, list: if true;
      allow create: if isValidId(courierId);
      allow update: if isValidId(courierId) && isTenantImmutable();
      allow delete: if isValidId(courierId);
    }

    // =========================================================================
    // 5. TENANT-ISOLATED FINANCIAL & INVENTORY COLLECTIONS
    // =========================================================================
    match /financialRecords/{recordId} {
      allow get, list: if true;
      allow create: if isValidId(recordId) && hasTenantId();
      allow update: if isValidId(recordId) && isTenantImmutable();
      allow delete: if isValidId(recordId);
    }

    match /financial_records/{recordId} {
      allow get, list: if true;
      allow create: if isValidId(recordId) && hasTenantId();
      allow update: if isValidId(recordId) && isTenantImmutable();
      allow delete: if isValidId(recordId);
    }

    match /cashClosings/{closingId} {
      allow get, list: if true;
      allow create: if isValidId(closingId) && hasTenantId();
      allow update: if isValidId(closingId) && isTenantImmutable();
      allow delete: if isValidId(closingId);
    }

    match /cash_closings/{closingId} {
      allow get, list: if true;
      allow create: if isValidId(closingId) && hasTenantId();
      allow update: if isValidId(closingId) && isTenantImmutable();
      allow delete: if isValidId(closingId);
    }

    match /rawMaterials/{materialId} {
      allow get, list: if true;
      allow create: if isValidId(materialId) && hasTenantId();
      allow update: if isValidId(materialId) && isTenantImmutable();
      allow delete: if isValidId(materialId);
    }

    match /bankAccounts/{accountId} {
      allow get, list: if true;
      allow create: if isValidId(accountId) && hasTenantId();
      allow update: if isValidId(accountId) && isTenantImmutable();
      allow delete: if isValidId(accountId);
    }

    // =========================================================================
    // 6. FISCAL, AUDIT & SAAS PLATFORM COLLECTIONS
    // =========================================================================
    match /fiscal_documents/{docId} {
      allow get, list: if true;
      allow create: if isValidId(docId);
      allow update: if isValidId(docId) && isTenantImmutable();
      allow delete: if isValidId(docId);
    }

    match /fiscalNotes/{docId} {
      allow get, list: if true;
      allow create, update: if isValidId(docId) && isTenantImmutable();
      allow delete: if isValidId(docId);
    }

    match /certificates/{certId} {
      allow get, list: if true;
      allow create, update: if isValidId(certId) && isTenantImmutable();
      allow delete: if isValidId(certId);
    }

    match /integration_events/{eventId} {
      allow get, list: if true;
      allow create, update: if isValidId(eventId) && isTenantImmutable();
      allow delete: if isValidId(eventId);
    }

    match /auditLogs/{logId} {
      allow get, list: if true;
      allow create, update: if isValidId(logId) && isTenantImmutable();
      allow delete: if isValidId(logId);
    }

    match /audit_logs/{logId} {
      allow get, list: if true;
      allow create, update: if isValidId(logId) && isTenantImmutable();
      allow delete: if isValidId(logId);
    }

    match /plans/{planId} {
      allow get, list, create, update, delete: if true;
    }

    match /commerceCategories/{categoryId} {
      allow get, list, create, update, delete: if true;
    }

    match /marketplace_settings/{settingId} {
      allow get, list, create, update, delete: if true;
    }

    match /marketplaceInvoices/{invoiceId} {
      allow get, list, create, update, delete: if true;
    }

    match /saasLedger/{entryId} {
      allow get, list, create, update, delete: if true;
    }

    match /saasPayments/{paymentId} {
      allow get, list, create, update, delete: if true;
    }

    match /leads/{leadId} {
      allow get, list, create, update, delete: if true;
    }

    match /tickets/{ticketId} {
      allow get, list, create, update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if isTenantImmutable();
    }
  }
}
